# ─────────────────────────────────────────────────────────────
# CINEMATCH · Configuración
# Copia este archivo como .env y rellena los valores.
# Ninguno de estos valores es secreto: acaban dentro del JavaScript público.
# ─────────────────────────────────────────────────────────────

# OBLIGATORIO. ID del Google Sheets (lo que va entre /d/ y /edit en la URL).
VITE_GOOGLE_SHEET_ID=

# OBLIGATORIO. GID de la pestaña (el número tras gid= en la URL). La primera pestaña suele ser 0.
VITE_GOOGLE_SHEET_GID=0

# OPCIONAL. URL CSV completa (por ejemplo la de "Publicar en la web" > CSV).
# Si la rellenas, se usa antes que el ID y el GID.
VITE_GOOGLE_SHEET_CSV_URL=

# OPCIONALES. Si los dejas vacíos se usan los valores de src/config/config.js
VITE_APP_NAME=
VITE_PERSON_1_NAME=
VITE_PERSON_2_NAME=
